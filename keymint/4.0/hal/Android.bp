package {
    default_applicable_licenses: [
        "external_libese_ready_se_google_keymint_KM300_HAL_license",
    ],
}

// Added automatically by a large-scale-change
// See: http://go/android-license-faq
license {
    name: "external_libese_ready_se_google_keymint_KM300_HAL_license",
    visibility: [":__subpackages__","//external/libese/ready_se/google/keymint/KM300/HAL"],
    license_kinds: [
        "SPDX-license-identifier-Apache-2.0",
    ],
    license_text: [
        "LICENSE",
    ],
}

cc_library {
    name: "libjc_keymint-thales",
    defaults: [
        "keymaster_defaults",
    ],
    srcs: [
        "CborConverter.cpp",
        "JavacardKeyMintDevice.cpp",
        "JavacardKeyMintOperation.cpp",
        "JavacardRemotelyProvisionedComponentDevice.cpp",
        "JavacardSecureElement.cpp",
        "JavacardSharedSecret.cpp",
        "keymint_utils.cpp",
    ],
    cflags: ["-O0", "-DKM400_ASN1"],
    shared_libs: [
        "android.hardware.security.keymint-V4-ndk",
        "android.hardware.security.secureclock-V1-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "android.hardware.security.rkp-V3-ndk",
        "lib_android_keymaster_keymint_utils_V4",
        "libbase",
        "libcppbor_external",
        "libkeymaster_portable",
        "libkeymaster_messages",
        "libsoft_attestation_cert",
        "liblog",
        "libcrypto",
        "libcutils",
        "libjc_keymint_transport-thales",
        "libbinder_ndk",
    ],
    export_include_dirs: [
        ".",
    ],
    vendor_available: true,
}

cc_library {
    name: "libjc_keymint_transport-thales",
    vendor_available: true,
    srcs: [
        "SocketTransport.cpp",
       "SeTransport.cpp"
    ],
    export_include_dirs: [
        "."
    ],

    cflags: [
        "-Wno-unused-parameter",
        "-Wno-unused-private-field",
    ],


    shared_libs: [
        "libbinder",
        "libbase",
        "liblog",
        "libbinder_ndk",
        "android.se.omapi-V1-ndk",
        "libhardware",
        "libcutils",
        "android.hardware.secure_element-V1-ndk",
    ],
}


cc_binary {
    name: "android.hardware.security.keymint-service.strongbox-thales",
    relative_install_path: "hw",
    init_rc: ["android.hardware.security.keymint-service.strongbox-thales.rc"],
    vintf_fragments: [
        "android.hardware.security.keymint-service.strongbox-thales.xml",
        "android.hardware.security.sharedsecret-service.strongbox-thales.xml",
    ],
    vendor: true,
    cflags: [
        "-Wall",
        "-Wextra",
    ],
    shared_libs: [
        "android.hardware.security.keymint-V4-ndk",
        "android.hardware.security.sharedsecret-V1-ndk",
        "lib_android_keymaster_keymint_utils_V4",
        "android.hardware.security.rkp-V3-ndk",
        "libbase",
        "libbinder_ndk",
        "libcppbor_external",
        "libcrypto",
        "libkeymaster_portable",
        "libjc_keymint-thales",
        "libjc_keymint_transport-thales",
        "liblog",
        "libutils",
        "android.se.omapi-V1-ndk",
        "android.hardware.secure_element-V1-ndk",
    ],
    srcs: [
        "service.cpp",
    ],
    required: [
        "android.hardware.strongbox_keystore-thales.xml",
    ],
}

prebuilt_etc {
    name: "android.hardware.strongbox_keystore-thales.xml",
    sub_dir: "permissions",
    vendor: true,
    src: "android.hardware.strongbox_keystore-thales.xml",
}
